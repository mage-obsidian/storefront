name: Split packages

on:
  push:
    branches: [master]

jobs:
  split:
    name: Split ${{ matrix.package }}
    if: ${{ !startsWith(github.event.head_commit.message, 'chore(release):') }}
    runs-on: ubuntu-latest
    concurrency:
      group: split-${{ matrix.package }}
      cancel-in-progress: false
    strategy:
      fail-fast: false
      matrix:
        package:
          - module-catalog
          - module-catalog-search
          - module-checkout
          - module-customer
          - module-downloadable
          - module-gift-message
          - module-instant-purchase
          - module-multishipping
          - module-persistent
          - module-product-alert
          - module-review
          - module-sales
          - module-search
          - module-send-friend
          - module-showcase
          - module-storefront
          - module-vault
          - module-wishlist
          - theme-base
    steps:
      - uses: actions/checkout@v4
      - uses: danharrin/monorepo-split-github-action@v2.4.0
        env:
          GITHUB_TOKEN: ${{ secrets.SPLIT_TOKEN }}
        with:
          package_directory: packages/${{ matrix.package }}
          repository_organization: mage-obsidian
          repository_name: ${{ matrix.package }}
          branch: master
          user_name: github-actions[bot]
          user_email: 41898282+github-actions[bot]@users.noreply.github.com
