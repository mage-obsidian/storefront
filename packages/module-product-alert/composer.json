{
    "name": "mage-obsidian/module-product-alert",
    "description": "Product alert compatibility for MageObsidian: price-drop and back-in-stock notify links on the product detail page.",
    "require": {
        "php": ">=8.3",
        "mage-obsidian/module-modern-frontend": "^4.0"
    },
    "type": "magento2-module",
    "license": [
        "MIT"
    ],
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "MageObsidian\\ProductAlert\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        }
    }
}
