<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd"
      extends="pagebuilder_products_carousel_form">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">pagebuilder_obsidian_products_form.pagebuilder_obsidian_products_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Obsidian Product Carousel</item>
    </argument>
    <settings>
        <deps>
            <dep>pagebuilder_obsidian_products_form.pagebuilder_obsidian_products_form_data_source</dep>
        </deps>
        <namespace>pagebuilder_obsidian_products_form</namespace>
    </settings>
    <dataSource name="pagebuilder_obsidian_products_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_PageBuilder/js/form/provider</item>
            </item>
        </argument>
        <dataProvider name="pagebuilder_obsidian_products_form_data_source" class="Magento\PageBuilder\Model\ContentType\DataProvider">
            <settings>
                <requestFieldName/>
                <primaryFieldName/>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="appearance_fieldset">
        <settings>
            <visible>false</visible>
        </settings>
    </fieldset>
</form>
