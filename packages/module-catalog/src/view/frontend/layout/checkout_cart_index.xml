<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.cart.crosssell">
            <arguments>
                <argument name="card" xsi:type="object">MageObsidian\Catalog\ViewModel\ProductCard</argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="before.body.end">
            <block class="MageObsidian\ModernFrontend\Block\Template" name="obsidian.cart_cross_sell_cart_actions"
                   template="Magento_Catalog::cart-actions.twig"/>
            <block class="MageObsidian\ModernFrontend\Block\Template" name="obsidian.cart_cross_sell_compare_actions"
                   template="Magento_Catalog::compare-actions.twig"/>
        </referenceContainer>
    </body>
</page>
