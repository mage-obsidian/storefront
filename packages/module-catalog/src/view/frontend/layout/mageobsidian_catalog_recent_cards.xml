<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="header.container" remove="true"/>
        <referenceContainer name="page.top" remove="true"/>
        <referenceContainer name="footer-container" remove="true"/>
        <referenceContainer name="before.body.end" remove="true"/>
        <referenceContainer name="sidebar.additional" remove="true"/>
        <referenceContainer name="content">
            <block class="MageObsidian\Catalog\Block\Recent\Cards" name="recent.cards"
                   template="Magento_Catalog::product/recent-cards.twig">
                <arguments>
                    <argument name="card" xsi:type="object">MageObsidian\Catalog\ViewModel\ProductCard</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
