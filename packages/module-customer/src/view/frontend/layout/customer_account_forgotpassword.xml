<?xml version="1.0"?>
<!--
  Forgot-password page structure (see customer_account_login.xml for why the
  core layout is re-declared). Reuses Magento\Customer\Block\Account\Forgotpassword
  as a data source. Native POST to customer/account/forgotPasswordPost (which
  sends the reset email); forgot-enhancer.ts adds inline email validation only.
-->
<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <meta name="robots" content="NOINDEX,NOFOLLOW"/>
        <!-- Re-declare the title the suppressed core <head> would have set. -->
        <title>Forgot Your Password?</title>
    </head>
    <body>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceContainer name="content">
            <block class="MageObsidian\ModernFrontend\Block\Template" name="obsidian.customer.forgotpassword"
                   template="Magento_Customer::form/forgotpassword.twig">
                <!-- Name MUST be `forgotPassword`: the core ForgotPassword controller
                     looks the block up by that name to seed the persisted email. -->
                <block class="Magento\Customer\Block\Account\Forgotpassword" name="forgotPassword" as="form_data"/>
                <!-- The platform's own challenges. Both blocks render an empty string
                     until the store's configuration demands one, and the templates
                     put them where the form can carry their answer. `cacheable`
                     follows core: the image challenge is per session, the
                     reCAPTCHA site key is not. -->
                <block class="Magento\Captcha\Block\Captcha\DefaultCaptcha" name="customer.forgotpassword.captcha" as="captcha"
                       template="Magento_Captcha::default.twig" cacheable="false">
                    <arguments>
                        <argument name="form_id" xsi:type="string">user_forgotpassword</argument>
                        <argument name="img_width" xsi:type="number">230</argument>
                        <argument name="img_height" xsi:type="number">50</argument>
                    </arguments>
                </block>
                <block class="MageObsidian\ModernFrontend\Block\Template" name="customer.forgotpassword.recaptcha" as="recaptcha"
                       template="Magento_ReCaptchaFrontendUi::recaptcha.twig">
                    <arguments>
                        <argument name="view_model" xsi:type="object">MageObsidian\Storefront\ViewModel\ReCaptcha</argument>
                        <argument name="recaptcha_for" xsi:type="string">customer_forgot_password</argument>
                    </arguments>
                </block>
            </block>
        </referenceContainer>
    </body>
</page>
