<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="MageObsidian\Customer\ViewModel\AccountNav">
        <arguments>
            <argument name="links" xsi:type="array">
                <item name="downloadable" xsi:type="array">
                    <item name="route" xsi:type="string">downloadable/customer/products</item>
                    <item name="match" xsi:type="string">downloadable_customer_products</item>
                    <item name="label" xsi:type="string" translate="true">My Downloadable Products</item>
                    <item name="icon" xsi:type="string">arrow-down-tray</item>
                    <item name="sortOrder" xsi:type="string">25</item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
