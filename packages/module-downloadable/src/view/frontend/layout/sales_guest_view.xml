<!-- Purchased-link list on downloadable lines in the guest order view. -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="sales.guest.order.view">
            <arguments>
                <argument name="downloadable_links" xsi:type="object">MageObsidian\Downloadable\ViewModel\OrderItemLinks</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
