<?xml version="1.0"?>
<!--
    Registers the commerce Twig extension on the engine's shared environment by
    adding an item to its `extensions` array. The array merges across modules by
    item key, so this contributes `storefront_price` alongside the engine's own
    `mage_obsidian` and `format` items without editing the engine.

    Declared at GLOBAL scope (not etc/frontend) on purpose: array arguments merge
    cumulatively within a scope, but an area scope (frontend) REPLACES a global
    array instead of merging — which would drop the engine's own extensions in
    the frontend. The extension is only ever instantiated when the Twig
    environment is built (frontend rendering), so a global declaration is inert
    elsewhere. Requires MageObsidian_ModernFrontendTwig (declared in sequence).
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="MageObsidian\ModernFrontendTwig\Model\Template\EnvironmentFactory">
        <arguments>
            <argument name="extensions" xsi:type="array">
                <item name="storefront_price" xsi:type="object">MageObsidian\Storefront\Model\Template\Extension\PriceExtension</item>
            </argument>
        </arguments>
    </type>
    <type name="MageObsidian\ModernFrontend\ViewModel\PrePaintConfig">
        <arguments>
            <argument name="counters" xsi:type="array">
                <item name="cart" xsi:type="array">
                    <item name="island" xsi:type="string">MageObsidian_Storefront::cart/CartCount</item>
                    <item name="section" xsi:type="string">cart</item>
                    <item name="field" xsi:type="string">summary_count</item>
                </item>
                <item name="compare" xsi:type="array">
                    <item name="island" xsi:type="string">MageObsidian_Storefront::compare/CompareCount</item>
                    <item name="section" xsi:type="string">compare-products</item>
                    <item name="field" xsi:type="string">items</item>
                    <item name="kind" xsi:type="string">size</item>
                </item>
                <item name="wishlist" xsi:type="array">
                    <item name="island" xsi:type="string">MageObsidian_Storefront::wishlist/WishlistCount</item>
                    <item name="section" xsi:type="string">wishlist</item>
                    <item name="field" xsi:type="string">saved</item>
                    <item name="kind" xsi:type="string">size</item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Cms\Block\Page">
        <plugin name="mage_obsidian_render_cms_page_template"
                type="MageObsidian\Storefront\Plugin\Cms\RenderThemeTemplate"
                sortOrder="10"/>
        <plugin name="mage_obsidian_wrap_cms_page_content"
                type="MageObsidian\Storefront\Plugin\Cms\WrapAuthoredContent"
                sortOrder="20"/>
    </type>
    <type name="Magento\Cms\Block\Block">
        <plugin name="mage_obsidian_wrap_cms_block_content"
                type="MageObsidian\Storefront\Plugin\Cms\WrapAuthoredContent"/>
    </type>

    <!-- Every piece of authored content goes through this filter, so hooking it
         rather than a block treats Page Builder content the same on a CMS page,
         a CMS block, a product description and a widget. The high sort order
         puts it after Page Builder's own plugin on the same method. -->
    <type name="Magento\Framework\Filter\Template">
        <plugin name="mage_obsidian_secure_authored_styles"
                type="MageObsidian\Storefront\Plugin\PageBuilder\SecureAuthoredStyles"
                sortOrder="100"/>
    </type>

    <!-- The islands this module allows to be placed from content. The Page
         Builder content types write the same components into their saved
         markup, so registering them here is what also makes them reachable by
         the island widget and the {{island}} directive. -->
    <type name="MageObsidian\ModernFrontend\Service\Cms\IslandRegistry">
        <arguments>
            <argument name="islands" xsi:type="array">
                <item name="obsidian_map" xsi:type="array">
                    <item name="component" xsi:type="string">MageObsidian_Storefront::pagebuilder/ObsidianMap</item>
                    <item name="label" xsi:type="string" translate="true">Obsidian Map</item>
                    <item name="description" xsi:type="string" translate="true">A location shown without calling a map provider; the interactive map loads only when the visitor asks. Set "latitude" and "longitude", and optionally "locationName", "address" and "phone".</item>
                    <item name="props" xsi:type="array">
                        <item name="latitude" xsi:type="string"></item>
                        <item name="longitude" xsi:type="string"></item>
                        <item name="locationName" xsi:type="string"></item>
                        <item name="address" xsi:type="string"></item>
                        <item name="phone" xsi:type="string"></item>
                    </item>
                </item>
                <item name="obsidian_banner" xsi:type="array">
                    <item name="component" xsi:type="string">MageObsidian_Storefront::pagebuilder/ObsidianBanner</item>
                    <item name="label" xsi:type="string" translate="true">Obsidian Banner</item>
                    <item name="description" xsi:type="string" translate="true">A banner whose button can be revealed on interaction, reachable by keyboard and on screens with no pointer. Set "heading", and optionally "message", "buttonLabel", "buttonUrl", "overlayColor" and "reveal".</item>
                    <item name="props" xsi:type="array">
                        <item name="heading" xsi:type="string"></item>
                        <item name="message" xsi:type="string"></item>
                        <item name="buttonLabel" xsi:type="string"></item>
                        <item name="buttonUrl" xsi:type="string"></item>
                        <item name="overlayColor" xsi:type="string">transparent</item>
                        <item name="reveal" xsi:type="string">always</item>
                    </item>
                </item>
            </argument>
        </arguments>
    </type>

</config>
