<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        Frontend scope only: Page\Config::getRobots() already forces NOINDEX,NOFOLLOW
        outside the storefront, and none of this metadata belongs in the admin.
    -->
    <type name="Magento\Framework\View\Page\Config\Renderer">
        <plugin name="mage_obsidian_head_metadata"
                type="MageObsidian\Storefront\Plugin\View\Page\Config\HeadMetadata"
                sortOrder="10"/>
    </type>

    <!--
        Which og properties another block already writes into the head, so the
        product page is complemented instead of duplicated. Keyed by block name,
        valued by the layout argument holding that block's source object: the
        object is asked for its own properties, so the list never has to be kept
        in sync by hand. MageObsidian_Catalog owns `opengraph.general`.
    -->
    <type name="MageObsidian\Storefront\Model\Seo\ClaimedSocialProperties">
        <arguments>
            <argument name="claimants" xsi:type="array">
                <item name="opengraph.general" xsi:type="string">open_graph</item>
            </argument>
        </arguments>
    </type>
</config>
