<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        Frontend scope only: Page\Config::getRobots() already forces NOINDEX,NOFOLLOW
        outside the storefront, and none of this metadata belongs in the admin.
    -->
    <type name="Magento\Framework\View\Page\Config\Renderer">
        <plugin name="mage_obsidian_head_metadata"
                type="MageObsidian\Storefront\Plugin\View\Page\Config\HeadMetadata"
                sortOrder="10"/>
    </type>

    <!--
        Which og properties another block already writes into the head, so the
        product page is complemented instead of duplicated. Keyed by block name,
        valued by the layout argument holding that block's source object: the
        object is asked for its own properties, so the list never has to be kept
        in sync by hand. MageObsidian_Catalog owns `opengraph.general`.
    -->
    <type name="MageObsidian\Storefront\Model\Seo\ClaimedSocialProperties">
        <arguments>
            <argument name="claimants" xsi:type="array">
                <item name="opengraph.general" xsi:type="string">open_graph</item>
            </argument>
        </arguments>
    </type>

    <!-- Which authored content asks for which behaviour. A module or a theme
         adds a virtual type of its own and one item to the map below; nothing
         in PHP has to change. The map is a flat array of objects on purpose:
         nested array items compile empty here, with no error to notice. -->
    <virtualType name="MageObsidian\Storefront\Model\PageBuilder\Detector\Tabs"
                 type="MageObsidian\Storefront\Model\PageBuilder\Detector\MarkerDetector">
        <arguments>
            <argument name="marker" xsi:type="string">data-content-type="tabs"</argument>
            <argument name="module" xsi:type="string">MageObsidian_Storefront::js/page-builder</argument>
        </arguments>
    </virtualType>

    <virtualType name="MageObsidian\Storefront\Model\PageBuilder\Detector\Slider"
                 type="MageObsidian\Storefront\Model\PageBuilder\Detector\MarkerDetector">
        <arguments>
            <argument name="marker" xsi:type="string">data-content-type="slider"</argument>
            <argument name="module" xsi:type="string">MageObsidian_Storefront::js/page-builder</argument>
        </arguments>
    </virtualType>

    <virtualType name="MageObsidian\Storefront\Model\PageBuilder\Detector\Parallax"
                 type="MageObsidian\Storefront\Model\PageBuilder\Detector\MarkerDetector">
        <arguments>
            <argument name="marker" xsi:type="string">data-enable-parallax="1"</argument>
            <argument name="module" xsi:type="string">MageObsidian_Storefront::js/parallax</argument>
        </arguments>
    </virtualType>

    <virtualType name="MageObsidian\Storefront\Model\PageBuilder\Detector\VideoBackground"
                 type="MageObsidian\Storefront\Model\PageBuilder\Detector\MarkerDetector">
        <arguments>
            <argument name="marker" xsi:type="string">data-background-type="video"</argument>
            <argument name="module" xsi:type="string">MageObsidian_Storefront::js/video-background</argument>
        </arguments>
    </virtualType>

    <virtualType name="MageObsidian\Storefront\Model\PageBuilder\Detector\SameWidthButtons"
                 type="MageObsidian\Storefront\Model\PageBuilder\Detector\MarkerDetector">
        <arguments>
            <argument name="marker" xsi:type="string">data-same-width="true"</argument>
            <argument name="module" xsi:type="string">MageObsidian_Storefront::js/buttons</argument>
        </arguments>
    </virtualType>

    <virtualType name="MageObsidian\Storefront\Model\PageBuilder\Detector\ProductCarousel"
                 type="MageObsidian\Storefront\Model\PageBuilder\Detector\MarkerDetector">
        <arguments>
            <argument name="marker" xsi:type="string">data-appearance="carousel"</argument>
            <argument name="module" xsi:type="string">MageObsidian_Storefront::js/product-carousel</argument>
        </arguments>
    </virtualType>

    <virtualType name="MageObsidian\Storefront\Model\PageBuilder\Detector\Map"
                 type="MageObsidian\Storefront\Model\PageBuilder\Detector\MarkerDetector">
        <arguments>
            <argument name="marker" xsi:type="string">data-content-type="map"</argument>
            <argument name="module" xsi:type="string">MageObsidian_Storefront::js/map</argument>
        </arguments>
    </virtualType>

    <virtualType name="MageObsidian\Storefront\Model\PageBuilder\Detector\RevealOverlay"
                 type="MageObsidian\Storefront\Model\PageBuilder\Detector\MarkerDetector">
        <arguments>
            <argument name="marker" xsi:type="string">data-show-overlay="hover"</argument>
            <argument name="module" xsi:type="string">MageObsidian_Storefront::js/reveal-on-interaction</argument>
        </arguments>
    </virtualType>

    <virtualType name="MageObsidian\Storefront\Model\PageBuilder\Detector\RevealButton"
                 type="MageObsidian\Storefront\Model\PageBuilder\Detector\MarkerDetector">
        <arguments>
            <argument name="marker" xsi:type="string">data-show-button="hover"</argument>
            <argument name="module" xsi:type="string">MageObsidian_Storefront::js/reveal-on-interaction</argument>
        </arguments>
    </virtualType>

    <type name="MageObsidian\Storefront\Model\PageBuilder\Enhancer">
        <arguments>
            <argument name="detectors" xsi:type="array">
                <item name="tabs" xsi:type="object">MageObsidian\Storefront\Model\PageBuilder\Detector\Tabs</item>
                <item name="slider" xsi:type="object">MageObsidian\Storefront\Model\PageBuilder\Detector\Slider</item>
                <item name="parallax" xsi:type="object">MageObsidian\Storefront\Model\PageBuilder\Detector\Parallax</item>
                <item name="video_background" xsi:type="object">MageObsidian\Storefront\Model\PageBuilder\Detector\VideoBackground</item>
                <item name="same_width_buttons" xsi:type="object">MageObsidian\Storefront\Model\PageBuilder\Detector\SameWidthButtons</item>
                <item name="product_carousel" xsi:type="object">MageObsidian\Storefront\Model\PageBuilder\Detector\ProductCarousel</item>
                <item name="map" xsi:type="object">MageObsidian\Storefront\Model\PageBuilder\Detector\Map</item>
                <item name="reveal_overlay" xsi:type="object">MageObsidian\Storefront\Model\PageBuilder\Detector\RevealOverlay</item>
                <item name="reveal_button" xsi:type="object">MageObsidian\Storefront\Model\PageBuilder\Detector\RevealButton</item>
            </argument>
        </arguments>
    </type>
</config>
