{
    "name": "mage-obsidian/module-instant-purchase",
    "description": "Instant Purchase compatibility for MageObsidian: the PDP one-click buy button rendered as a Vue island over the native instant-purchase customer-data section.",
    "require": {
        "php": ">=8.3",
        "mage-obsidian/module-modern-frontend": "^4.0",
        "mage-obsidian/module-storefront": "^4.0"
    },
    "type": "magento2-module",
    "license": [
        "MIT"
    ],
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "MageObsidian\\InstantPurchase\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        }
    }
}
