<?xml version="1.0"?>
<!--
  The "My Orders" link itself is declared by MageObsidian_Customer (it is one of
  the baseline account entries); this only attaches the badge, because the count
  is sales' business. The \Proxy keeps the collection factory and the COUNT out
  of every page that never draws the rail.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="MageObsidian\Customer\ViewModel\AccountNav">
        <arguments>
            <argument name="links" xsi:type="array">
                <item name="orders" xsi:type="array">
                    <item name="counter" xsi:type="object">MageObsidian\Sales\Model\AccountNavCounter\Orders\Proxy</item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
