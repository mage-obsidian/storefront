<?xml version="1.0"?>
<!-- Shipment email item renderer (default) rendered through Twig. -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd"
      design_abstraction="custom">
    <body>
        <referenceBlock name="sales.email.order.shipment.renderers">
            <block class="Magento\Sales\Block\Order\Email\Items\DefaultItems"
                   name="sales.email.order.shipment.renderers.default" as="default"
                   template="Magento_Sales::email/items/shipment/default.twig"/>
        </referenceBlock>
    </body>
</page>
