      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="items">
            <block class="Magento\Sales\Block\Order\Email\Items\DefaultItems" name="item_price"
                   template="Magento_Sales::email/items/price/row.twig"/>
        </referenceBlock>
    </body>
</page>
