<?xml version="1.0"?>
<!--
  Printable shipment. Standalone like sales_order_print; data source is the core
  PrintOrder\Shipment block (order + shipment collection, with tracking).
  OrderTitle restores the <title>.
-->
<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceContainer name="content">
            <block class="MageObsidian\ModernFrontend\Block\Template" name="sales.order.print.shipment"
                   template="Magento_Sales::account/print-shipment.twig" cacheable="false">
                <block class="MageObsidian\Sales\Block\OrderTitle" name="print.shipment.title"/>
                <block class="Magento\Sales\Block\Order\PrintOrder\Shipment"
                       name="sales.order.print.shipment.source" as="print"/>
            </block>
        </referenceContainer>
    </body>
</page>
