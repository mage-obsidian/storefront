<?xml version="1.0"?>
<!--
  Customer credit memo (refund) view. Account shell + our Twig over the core
  Order\Creditmemo block (data source for the order and its credit memo
  collection) and Order\Info. OrderTitle restores the <title>. cacheable="false".
-->
<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceBlock name="account.shell">
            <block class="MageObsidian\ModernFrontend\Block\Template" name="account.order.creditmemo"
                   as="account_content" template="Magento_Sales::account/order-creditmemo.twig" cacheable="false">
                <arguments>
                    <argument name="item_options" xsi:type="object">MageObsidian\Sales\ViewModel\ItemOptions</argument>
                    <argument name="tax_breakdown" xsi:type="object">MageObsidian\Sales\ViewModel\TaxBreakdown</argument>
                </arguments>
                <block class="MageObsidian\Sales\Block\OrderTitle" name="account.creditmemo.title"/>
                <block class="Magento\Sales\Block\Order\Creditmemo" name="sales.order.creditmemo" as="creditmemo"/>
                <block class="Magento\Sales\Block\Order\Info" name="sales.order.info" as="info"/>
            </block>
        </referenceBlock>
    </body>
</page>
