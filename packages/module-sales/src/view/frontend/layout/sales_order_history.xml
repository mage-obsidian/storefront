<?xml version="1.0"?>
<!--
  Order history. Pulls in the account shell, then renders our Twig over the core
  Order\History block (kept as data source for the order collection, view and
  reorder URLs). The controller sets the 'My Orders' title. cacheable="false"
  so the customer-specific list is never depersonalized.
-->
<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceBlock name="account.shell">
            <block class="MageObsidian\ModernFrontend\Block\Template" name="account.orders"
                   as="account_content" template="Magento_Sales::account/order-history.twig" cacheable="false">
                <arguments>
                    <argument name="cancellation" xsi:type="object">Magento\OrderCancellationUi\ViewModel\Config</argument>
                    <argument name="order_presentation" xsi:type="object">MageObsidian\Sales\ViewModel\OrderPresentation</argument>
                </arguments>
                <!-- Our subclass only re-templates the pager the core block builds
                     for itself; see MageObsidian\Sales\Block\Order\History. -->
                <block class="MageObsidian\Sales\Block\Order\History" name="sales.order.history" as="history"/>
            </block>
        </referenceBlock>
    </body>
</page>
