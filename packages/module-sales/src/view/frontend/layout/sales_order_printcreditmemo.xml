<?xml version="1.0"?>
<!--
  Printable credit memo. Standalone like sales_order_print; data source is the
  core PrintOrder\Creditmemo block (single credit memo or the whole collection
  on "print all"). OrderTitle restores the <title>.
-->
<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceContainer name="content">
            <block class="MageObsidian\ModernFrontend\Block\Template" name="sales.order.print.creditmemo"
                   template="Magento_Sales::account/print-creditmemo.twig" cacheable="false">
                <arguments>
                    <argument name="item_options" xsi:type="object">MageObsidian\Sales\ViewModel\ItemOptions</argument>
                    <argument name="tax_breakdown" xsi:type="object">MageObsidian\Sales\ViewModel\TaxBreakdown</argument>
                </arguments>
                <block class="MageObsidian\Sales\Block\OrderTitle" name="print.creditmemo.title"/>
                <block class="Magento\Sales\Block\Order\PrintOrder\Creditmemo"
                       name="sales.order.print.creditmemo.source" as="print"/>
            </block>
        </referenceContainer>
    </body>
</page>
