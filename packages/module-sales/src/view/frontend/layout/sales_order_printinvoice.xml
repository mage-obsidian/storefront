<?xml version="1.0"?>
<!--
  Printable invoice. Standalone (no account shell), like sales_order_print: the
  theme header/footer carry print:hidden so the browser prints just the document.
  Data source is the core PrintOrder\Invoice block (single invoice when printing
  one, the whole collection on "print all"). OrderTitle restores the <title>.
-->
<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceContainer name="content">
            <block class="MageObsidian\ModernFrontend\Block\Template" name="sales.order.print.invoice"
                   template="Magento_Sales::account/print-invoice.twig" cacheable="false">
                <block class="MageObsidian\Sales\Block\OrderTitle" name="print.invoice.title"/>
                <block class="Magento\Sales\Block\Order\PrintOrder\Invoice"
                       name="sales.order.print.invoice.source" as="print"/>
            </block>
        </referenceContainer>
    </body>
</page>
