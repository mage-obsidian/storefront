<?xml version="1.0"?>
<!--
  Printable order. The native print layout is suppressed (Magento_Sales not
  opted-in), so this re-declares it standalone (no account shell) and reuses the
  order-view Twig over the same Order\View / Items / Totals / Info data sources.
  The header/footer carry print:hidden, so the browser prints just the order.
  OrderTitle restores the <title>; cacheable="false" — customer data.
-->
<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceContainer name="content">
            <block class="MageObsidian\ModernFrontend\Block\Template" name="sales.order.print"
                   template="Magento_Sales::account/order-view.twig" cacheable="false">
                <arguments>
                    <argument name="item_options" xsi:type="object">MageObsidian\Sales\ViewModel\ItemOptions</argument>
                    <argument name="order_presentation" xsi:type="object">MageObsidian\Sales\ViewModel\OrderPresentation</argument>
                </arguments>
                <block class="MageObsidian\Sales\Block\OrderTitle" name="print.order.title"/>
                <block class="Magento\Sales\Block\Order\View" name="sales.order.view" as="view"/>
                <block class="Magento\Sales\Block\Order\Items" name="order_items" as="items"/>
                <block class="Magento\Sales\Block\Order\Totals" name="order_totals" as="totals"
                       template="Magento_Sales::account/order-totals.twig">
                    <arguments>
                        <argument name="tax_breakdown" xsi:type="object">MageObsidian\Sales\ViewModel\TaxBreakdown</argument>
                    </arguments>
                </block>
                <block class="Magento\Sales\Block\Order\Info" name="sales.order.info" as="info"/>
            </block>
        </referenceContainer>
    </body>
</page>
