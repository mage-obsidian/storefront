<!--
  Guest shipment view. Standalone; reuses the customer order-shipment Twig with
  the guest route prefix. Shipment data comes from Shipping\Block\Order\Shipment.
-->
<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceContainer name="content">
            <block class="MageObsidian\ModernFrontend\Block\Template" name="sales.guest.order.shipment"
                   template="Magento_Sales::account/order-shipment.twig" cacheable="false">
                <arguments>
                    <argument name="route_prefix" xsi:type="string">sales/guest</argument>
                    <argument name="is_guest" xsi:type="boolean">true</argument>
                    <argument name="item_options" xsi:type="object">MageObsidian\Sales\ViewModel\ItemOptions</argument>
                    <argument name="order_presentation" xsi:type="object">MageObsidian\Sales\ViewModel\OrderPresentation</argument>
                </arguments>
                <block class="Magento\Sales\Block\Order\Info\Buttons" name="sales.order.info.buttons" template="Magento_Sales::order/info/buttons.twig" cacheable="false">
                    <arguments>
                        <argument name="reorder_policy" xsi:type="object">MageObsidian\Sales\ViewModel\ReorderPolicy</argument>
                    </arguments>
                    <block class="MageObsidian\ModernFrontend\Block\Template" name="sales.order.info.buttons.rss"
                           template="Magento_Sales::order/info/buttons/rss.twig" ifconfig="rss/config/active" cacheable="false">
                        <arguments>
                            <argument name="order_feed" xsi:type="object">MageObsidian\Sales\ViewModel\OrderStatusFeed</argument>
                        </arguments>
                    </block>
                </block>
                <block class="Magento\Sales\Block\Order\Comments" name="shipment_comments" template="Magento_Sales::order/comments.twig" cacheable="false">
                    <arguments>
                        <argument name="title" xsi:type="string" translate="true">About Your Shipment</argument>
                    </arguments>
                </block>
                <block class="MageObsidian\Sales\Block\OrderTitle" name="guest.shipment.title"/>
                <block class="Magento\Shipping\Block\Order\Shipment" name="sales.order.shipment" as="shipment"/>
                <block class="Magento\Sales\Block\Order\Info" name="sales.order.info" as="info"/>
            </block>
        </referenceContainer>
    </body>
</page>
