{
    "name": "mage-obsidian/theme-base",
    "description": "MageObsidian base storefront theme: pulls the modern-frontend engine and the full storefront module stack for Luma-level parity.",
    "type": "magento2-theme",
    "license": [
        "MIT"
    ],
    "require": {
        "mage-obsidian/component-modern-frontend": "^4.1",
        "mage-obsidian/module-catalog": "^4.2",
        "mage-obsidian/module-catalog-search": "^4.2",
        "mage-obsidian/module-checkout": "^4.2",
        "mage-obsidian/module-customer": "^4.2",
        "mage-obsidian/module-downloadable": "^4.2",
        "mage-obsidian/module-gift-message": "^4.2",
        "mage-obsidian/module-instant-purchase": "^4.2",
        "mage-obsidian/module-multishipping": "^4.2",
        "mage-obsidian/module-persistent": "^4.2",
        "mage-obsidian/module-product-alert": "^4.2",
        "mage-obsidian/module-review": "^4.2",
        "mage-obsidian/module-sales": "^4.2",
        "mage-obsidian/module-send-friend": "^4.2",
        "mage-obsidian/module-storefront": "^4.2",
        "mage-obsidian/module-vault": "^4.2",
        "mage-obsidian/module-wishlist": "^4.2"
    },
    "autoload": {
        "files": [
            "registration.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        }
    }
}
