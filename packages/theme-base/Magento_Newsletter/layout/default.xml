<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="footer.content">
            <block class="Magento\Newsletter\Block\Subscribe" name="form.subscribe" as="subscribe" after="-"
                   template="Magento_Newsletter::subscribe.phtml" ifconfig="newsletter/general/active">
                <arguments>
                    <argument name="button_lock_manager" xsi:type="object">
                        Magento\Framework\View\Element\ButtonLockManager
                    </argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
