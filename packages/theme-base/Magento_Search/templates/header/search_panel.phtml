<?php // External rather than inline: checkout_index_index enforces CSP with inline
      // scripts disallowed (Magento_Checkout ships it that way for PCI), and an
      // inline tag dies there. A same-origin file is covered by 'self'. ?>
<script type="module" src="<?= $escaper->escapeUrl($block->resolvePathByName('js/search-panel.js')) ?>"></script>
