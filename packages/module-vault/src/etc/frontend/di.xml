<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="MageObsidian\Customer\ViewModel\AccountNav">
        <arguments>
            <argument name="links" xsi:type="array">
                <item name="vault_cards" xsi:type="array">
                    <item name="route" xsi:type="string">vault/cards/listaction</item>
                    <item name="match" xsi:type="string">vault_cards_listaction</item>
                    <item name="label" xsi:type="string" translate="true">Stored Payment Methods</item>
                    <item name="icon" xsi:type="string">credit-card</item>
                    <item name="sortOrder" xsi:type="string">160</item>
                </item>
            </argument>
        </arguments>
    </type>
    <preference for="MageObsidian\Checkout\Api\VaultTokenProviderInterface"
                type="MageObsidian\Vault\Model\CheckoutVaultTokenProvider"/>
</config>
