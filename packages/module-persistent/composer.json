{
    "name": "mage-obsidian/module-persistent",
    "description": "Persistent (Remember Me) compatibility for MageObsidian: the remember-me checkbox on the sign-in and registration forms.",
    "require": {
        "php": ">=8.3",
        "mage-obsidian/module-modern-frontend": "^4.0"
    },
    "type": "magento2-module",
    "license": [
        "MIT"
    ],
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "MageObsidian\\Persistent\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        }
    }
}
