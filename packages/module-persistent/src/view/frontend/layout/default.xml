<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="header-content">
            <block class="MageObsidian\ModernFrontend\Block\Template" name="obsidian.persistent.greeting"
                   as="persistent_greeting" template="Magento_Persistent::header/greeting.twig">
                <arguments>
                    <argument name="greeting" xsi:type="object">MageObsidian\Persistent\ViewModel\Greeting</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
