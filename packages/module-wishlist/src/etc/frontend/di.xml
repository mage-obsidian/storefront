<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Wishlist\CustomerData\Wishlist">
        <plugin name="mage_obsidian_wishlist_product_ids"
                type="MageObsidian\Wishlist\Plugin\CustomerData\WishlistSection"/>
    </type>
    <type name="MageObsidian\Customer\ViewModel\AccountNav">
        <arguments>
            <argument name="links" xsi:type="array">
                <item name="wishlist" xsi:type="array">
                    <item name="route" xsi:type="string">wishlist</item>
                    <item name="match" xsi:type="string">wishlist_index</item>
                    <item name="label" xsi:type="string" translate="true">My Wish List</item>
                    <item name="sortOrder" xsi:type="string">35</item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
