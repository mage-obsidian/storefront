<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="MageObsidian\Checkout\Api\VaultTokenProviderInterface"
                type="MageObsidian\Checkout\Model\NullVaultTokenProvider"/>
    <!--
      The checkout island's private seed. Registered alongside Magento's own
      sections rather than behind a bespoke endpoint, so it inherits the version
      cookie, the localStorage mirror and the batching the storefront already
      does on this page.
    -->
    <type name="Magento\Customer\CustomerData\SectionPoolInterface">
        <arguments>
            <argument name="sectionSourceMap" xsi:type="array">
                <item name="obsidian-checkout" xsi:type="string">MageObsidian\Checkout\CustomerData\CheckoutSection</item>
            </argument>
        </arguments>
    </type>
    <!--
      Keeps the checkout out of the page cache on the uncached paths (flag off,
      or ?obsidian_shell=0). See the plugin for why this is not a layout handle.
    -->
    <type name="Magento\Framework\View\Layout">
        <plugin name="mage_obsidian_checkout_uncacheable"
                type="MageObsidian\Checkout\Plugin\Layout\MakeCheckoutUncacheable"/>
    </type>
</config>
