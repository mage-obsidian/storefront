<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
      The checkout island's private seed. Registered alongside Magento's own
      sections rather than behind a bespoke endpoint, so it inherits the version
      cookie, the localStorage mirror and the batching the storefront already
      does on this page.
    -->
    <type name="Magento\Customer\CustomerData\SectionPoolInterface">
        <arguments>
            <argument name="sectionSourceMap" xsi:type="array">
                <item name="obsidian-checkout" xsi:type="string">MageObsidian\Checkout\CustomerData\CheckoutSection</item>
            </argument>
        </arguments>
    </type>
    <!--
      Keeps the checkout out of the page cache on the uncached paths (flag off,
      or ?obsidian_shell=0). See the plugin for why this is not a layout handle.
    -->
    <type name="Magento\Framework\View\Layout">
        <plugin name="mage_obsidian_checkout_uncacheable"
                type="MageObsidian\Checkout\Plugin\Layout\MakeCheckoutUncacheable"/>
    </type>
    <type name="MageObsidian\Checkout\Model\Payment\StoreScopedConfigProviders">
        <arguments>
            <argument name="excluded" xsi:type="array">
                <item name="checkout_default_config_provider" xsi:type="string">checkout_default_config_provider</item>
                <item name="checkout_summary_config_provider" xsi:type="string">checkout_summary_config_provider</item>
                <item name="vault_cards_config_provider" xsi:type="string">vault_cards_config_provider</item>
                <item name="persistent_checkout_config_provider" xsi:type="string">persistent_checkout_config_provider</item>
            </argument>
        </arguments>
    </type>
    <type name="MageObsidian\Checkout\Model\Payment\MethodConfig">
        <arguments>
            <argument name="configProviders" xsi:type="object">MageObsidian\Checkout\Model\Payment\StoreScopedConfigProviders</argument>
            <argument name="keyAliases" xsi:type="array">
                <item name="paypalBillingAgreement" xsi:type="string">paypal_billing_agreement</item>
            </argument>
        </arguments>
    </type>
    <type name="MageObsidian\Checkout\Model\Payment\NeedsOwnUi">
        <arguments>
            <argument name="layoutFiles" xsi:type="object">layoutFileSourceBase</argument>
            <argument name="completableGenerically" xsi:type="array">
                <item name="checkmo" xsi:type="string">checkmo</item>
                <item name="banktransfer" xsi:type="string">banktransfer</item>
                <item name="cashondelivery" xsi:type="string">cashondelivery</item>
                <item name="purchaseorder" xsi:type="string">purchaseorder</item>
                <item name="free" xsi:type="string">free</item>
            </argument>
        </arguments>
    </type>
</config>
