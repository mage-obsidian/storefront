{
    "name": "mage-obsidian/module-checkout",
    "description": "Checkout domain compatibility for MageObsidian: mini-cart drawer and shopping bag page (Vue islands, layout and ViewModels) built on the storefront foundation.",
    "require": {
        "php": ">=8.3",
        "mage-obsidian/module-modern-frontend": "^4.0",
        "mage-obsidian/module-storefront": "^4.0"
    },
    "type": "magento2-module",
    "license": [
        "MIT"
    ],
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "MageObsidian\\Checkout\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        }
    }
}
