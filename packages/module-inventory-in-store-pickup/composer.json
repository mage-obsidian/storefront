{
    "name": "mage-obsidian/module-inventory-in-store-pickup",
    "description": "In-store pickup for the MageObsidian checkout: a delivery method selector and a pickup location finder over the Multi-Source Inventory pickup endpoints. Optional: stores without MSI do not install it.",
    "require": {
        "php": ">=8.3",
        "mage-obsidian/module-modern-frontend": "^4.0",
        "mage-obsidian/module-checkout": "^4.0",
        "magento/module-inventory-in-store-pickup-api": "^1.0",
        "magento/module-inventory-in-store-pickup-shipping-api": "^1.0"
    },
    "type": "magento2-module",
    "license": [
        "MIT"
    ],
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "MageObsidian\\InventoryInStorePickup\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        }
    }
}
